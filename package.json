{
  "name": "nopostnow",
  "version": "0.1.0",
  "private": true,
  "description": "A private, self-hostable photo feed for trusted circles.",
  "license": "MIT",
  "homepage": "https://nopostnow.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jthy10/nopostnow.git"
  },
  "bugs": {
    "url": "https://github.com/jthy10/nopostnow/issues"
  },
  "engines": {
    "node": "20.x || >=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "setup:firebase": "node scripts/setup-local-env.mjs",
    "users": "node --env-file-if-exists=.env.local scripts/manage-user.mjs",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "@vercel/oidc": "^3.8.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "firebase-tools": "^15.26.0",
    "image-size": "^2.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0",
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.8",
    "fast-xml-parser": "5.10.1",
    "fast-uri": "3.1.4",
    "jwks-rsa": {
      "jose": "5.10.0"
    },
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "uuid": "11.1.1"
  }
}
