{
  "name": "nopostnow",
  "version": "0.2.4",
  "private": true,
  "description": "A private, self-hosted photo feed for you and your friends.",
  "license": "MIT",
  "homepage": "https://nopostnow.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jthy10/nopostnow.git"
  },
  "bugs": {
    "url": "https://github.com/jthy10/nopostnow/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "panel": "node scripts/panel.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/start.mjs --dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "users": "node scripts/users.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "next": "^16.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
